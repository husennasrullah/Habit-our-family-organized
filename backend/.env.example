# ─── App ──────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080

# ─── CORS ─────────────────────────────────────────────────
# Tambah origin tambahan dipisah koma (localhost:3000 sudah otomatis diizinkan)
# Contoh untuk ngrok: ALLOWED_ORIGINS=https://xxxx.ngrok-free.app
# ALLOWED_ORIGINS=

# ─── PostgreSQL ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=keluarga
DB_USER=keluarga_user
DB_PASSWORD=keluarga_pass
DB_SSL_MODE=disable

# ─── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass
REDIS_DB=0

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_BASE_URL=http://localhost:3000

# ─── Push Notification (Web Push / VAPID) ─────────────
# Generate dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@keluarga.dev
NOTIFICATION_TIME=0 4 * * *

# ─── Object Storage (MinIO dev / Cloudflare R2 / AWS S3) ──
# Pilih provider dan endpoint/credentials/region; lihat docs/storage.md.
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=keluarga
STORAGE_USE_SSL=false
# STORAGE_PUBLIC_URL=           # kosongkan = pakai presigned URL (private)
# STORAGE_PUBLIC_URL=https://pub-xxx.r2.dev        # contoh R2 public bucket
# STORAGE_PUBLIC_URL=https://media.keluarga.app    # contoh custom domain CDN

# Storage provider: minio | s3 | r2 | disabled (S3-compatible APIs)
STORAGE_PROVIDER=minio
# Production Docker defaults to minio:9000; local backend uses localhost:9000.
# For cloud set ALL endpoint/credentials explicitly; HTTPS recommended.
# STORAGE_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# STORAGE_ACCESS_KEY=your_access_key
# STORAGE_SECRET_KEY=your_secret_key
# STORAGE_REGION=ap-southeast-1
# STORAGE_SESSION_TOKEN=        # optional temporary S3 credentials
STORAGE_ADDRESSING_STYLE=auto   # auto | path | virtual
# Default: true for minio, false for cloud. Use existing cloud buckets.
# STORAGE_AUTO_CREATE_BUCKET=false
# STORAGE_USE_SSL=true          # endpoint URL scheme takes precedence
# DOCUMENT_ENCRYPTION_KEY=      # 64 hex characters; openssl rand -hex 32
# Keep this key permanently backed up; changing/removing it prevents decryption.
