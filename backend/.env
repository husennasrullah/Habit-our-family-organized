# ─── App ──────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080

# ─── PostgreSQL ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=keluarga
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

# ─── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=keluarga_jwt_secret_dev_2024_x9z
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# ─── Object Storage (MinIO dev / Cloudflare R2 / AWS S3) ──
# Ganti STORAGE_ENDPOINT + credentials saja saat pindah provider.
# Kode tidak perlu diubah — semua provider pakai S3-compatible API.
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=keluarga
STORAGE_USE_SSL=false
# STORAGE_PUBLIC_URL=           # kosongkan = pakai presigned URL (private)
# STORAGE_PUBLIC_URL=https://pub-xxx.r2.dev        # contoh R2 public bucket
# STORAGE_PUBLIC_URL=https://media.keluarga.app    # contoh custom domain CDN
ALLOWED_ORIGINS=https://9bf5-202-165-33-7.ngrok-free.app
