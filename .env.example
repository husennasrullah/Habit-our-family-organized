# ─────────────────────────────────────────────────────────────────────
#  .env.example — Root production environment variables
#
#  Cara pakai:
#    cp .env.example .env
#    Edit nilai yang ada (jangan commit .env ke repo!)
# ─────────────────────────────────────────────────────────────────────

# ─── Domain & URL ─────────────────────────────────────────────────────
DOMAIN=yourdomain.com
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://yourdomain.com

# ─── PostgreSQL ───────────────────────────────────────────────────────
# DB_HOST otomatis = container "postgres" (tidak perlu diubah)
DB_PORT=5432
DB_NAME=keluarga
DB_USER=keluarga_user
DB_PASSWORD=CHANGE_ME_strong_password
DB_SSL_MODE=disable

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password

# ─── JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_min_32_chars_random_string

# ─── Google OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── MinIO / Object Storage ───────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
STORAGE_BUCKET=keluarga
# STORAGE_PUBLIC_URL=          # kosongkan = pakai presigned URL (private)

# ─── Web Push (VAPID) ─────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@yourdomain.com
NOTIFICATION_TIME=0 4 * * *

# ─── GitHub Actions / Deploy ──────────────────────────────────────────
# Variabel ini TIDAK dipakai di docker-compose secara langsung,
# tapi dipakai di GitHub Actions secrets (lihat docs/deployment.md)
#
# SSH_HOST=1.2.3.4
# SSH_USER=deploy
# SSH_PORT=22
# DEPLOY_PATH=/opt/habit
