# ─────────────────────────────────────────────────────────────────────
#  .env.example — Root production environment variables
#
#  Cara pakai:
#    cp .env.example .env
#    Edit nilai yang ada (jangan commit .env ke repo!)
# ─────────────────────────────────────────────────────────────────────

# ─── Domain & URL ─────────────────────────────────────────────────────
DOMAIN=yourdomain.com
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://yourdomain.com

# ─── PostgreSQL ───────────────────────────────────────────────────────
# DB_HOST otomatis = container "postgres" (tidak perlu diubah)
DB_PORT=5432
DB_NAME=keluarga
DB_USER=keluarga_user
DB_PASSWORD=CHANGE_ME_strong_password
DB_SSL_MODE=disable

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password

# ─── JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_min_32_chars_random_string

# ─── Google OAuth ─────────────────────────────────────────────────────
# Dapatkan dari: https://console.cloud.google.com/ → APIs & Services → Credentials
# Authorized redirect URI yang harus didaftarkan di Google Cloud:
#   https://<DOMAIN_KAMU>/api/v1/auth/google/callback
# GOOGLE_REDIRECT_URL dan FRONTEND_BASE_URL otomatis dibentuk dari BACKEND_URL & FRONTEND_URL di atas
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── MinIO / Object Storage ───────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
STORAGE_BUCKET=keluarga
# STORAGE_PUBLIC_URL=          # kosongkan = pakai presigned URL (private)

# ─── Web Push (VAPID) ─────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@yourdomain.com
NOTIFICATION_TIME=0 4 * * *

# ─── GitHub Actions / Deploy ──────────────────────────────────────────
# Variabel ini TIDAK dipakai di docker-compose secara langsung,
# tapi dipakai di GitHub Actions secrets (lihat docs/deployment.md)
#
# SSH_HOST=1.2.3.4
# SSH_USER=deploy
# SSH_PORT=22
# DEPLOY_PATH=/opt/habit

# Storage provider: minio | s3 | r2 | disabled (S3-compatible APIs)
STORAGE_PROVIDER=minio
# Production Docker defaults to minio:9000; local backend uses localhost:9000.
# For cloud set ALL endpoint/credentials explicitly; HTTPS recommended.
# STORAGE_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# STORAGE_ACCESS_KEY=your_access_key
# STORAGE_SECRET_KEY=your_secret_key
# STORAGE_REGION=ap-southeast-1
# STORAGE_SESSION_TOKEN=        # optional temporary S3 credentials
STORAGE_ADDRESSING_STYLE=auto   # auto | path | virtual
# Default: true for minio, false for cloud. Use existing cloud buckets.
# STORAGE_AUTO_CREATE_BUCKET=false
# STORAGE_USE_SSL=true          # endpoint URL scheme takes precedence
# DOCUMENT_ENCRYPTION_KEY=      # 64 hex characters; openssl rand -hex 32
# Keep this key permanently backed up; changing/removing it prevents decryption.
